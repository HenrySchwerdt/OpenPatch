// project lives in a Trio checkout as OpenPatchKit/) provides DEVELOPER_TEAM; otherwise pick a team in Xcode.
#include? "../../ConfigOverride.xcconfig"
#include? "../../../ConfigOverride.xcconfig"
DEVELOPMENT_TEAM = $(DEVELOPER_TEAM)
