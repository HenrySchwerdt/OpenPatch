/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * OpenPatch bench controller: ALL pin assignments in one place (pinctrl + /zephyr,user GPIOs).
 * Source of truth: electronics/bench/pin-assignment.md.
 *
 * *** PLACEHOLDER PINS ***  Every pin below is a free-choice placeholder on a valid nRF52840
 * pad until electronics/bench/pin-assignment.md exists. They are NOT the board's real routing.
 * Do not connect hardware on the strength of this file. When the real table lands, edit only
 * this file and delete the `openpatch,placeholder-pins` property in /zephyr,user below; the
 * firmware prints a loud warning at every boot while the property is present.
 *
 * Avoided on purpose: P0.00/P0.01 (crystal pads on bare chips), P0.09/P0.10 (NFC pins),
 * P0.18 (nRESET, only if the board wires it).
 */

&pinctrl {
	/* PLACEHOLDER: TMAG5273 on I2C (optional part) */
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
				<NRF_PSEL(TWIM_SCL, 0, 27)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
				<NRF_PSEL(TWIM_SCL, 0, 27)>;
			low-power-enable;
		};
	};

	/* PLACEHOLDER: buzzer drive (BUZ_PWM) */
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 23)>;
		};
	};

	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 23)>;
			low-power-enable;
		};
	};

	/* PLACEHOLDER: HALL_A / HALL_B (2x DRV5032 in the pod, via FFC) -> QDEC */
	qdec_default: qdec_default {
		group1 {
			psels = <NRF_PSEL(QDEC_A, 1, 1)>,
				<NRF_PSEL(QDEC_B, 1, 2)>;
		};
	};

	qdec_sleep: qdec_sleep {
		group1 {
			psels = <NRF_PSEL(QDEC_A, 1, 1)>,
				<NRF_PSEL(QDEC_B, 1, 2)>;
			low-power-enable;
		};
	};
};

/ {
	zephyr,user {
		/* Remove this property when electronics/bench/pin-assignment.md has been applied. */
		openpatch,placeholder-pins;

		/* ---- STSPIN220 motor driver (full-step in firmware) ---- */
		motor-stck-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;  /* PLACEHOLDER STEP / MODE3 */
		motor-dir-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;   /* PLACEHOLDER DIR / MODE4 */
		/* STBY/RESET: high = driver active, pull-down on the board = fail-safe */
		motor-stby-gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;  /* PLACEHOLDER */
		/* EN/FAULT is open drain with a pull-up at the driver: read only */
		motor-fault-gpios = <&gpio0 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PLACEHOLDER */
		/* MODE1/MODE2 are strapped on the bench board (not driven by the MCU): no motor-mode*-gpios */

		/* ---- hardware interlock: VMOT = MCU enable AND TPL5010 latch AND DOCKED ---- */
		motor-enable-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;   /* PLACEHOLDER MCU motor-enable */
		motor-allow-mon-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>; /* PLACEHOLDER read-back: motor supply allowed */

		/* ---- TPL5010 external watchdog ---- */
		wdt-done-gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;  /* PLACEHOLDER DONE: CPU-served only */
		wdt-wake-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;  /* PLACEHOLDER WAKE pulse -> interrupt */

		/* ---- inputs from the pod / operator ---- */
		/* DOCKED: dock hall switch in the pod, via the FFC; asserted (low) = docked */
		dock-gpios = <&gpio0 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;   /* PLACEHOLDER */
		button-gpios = <&gpio0 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; /* PLACEHOLDER BTN_N */
		tmag-int-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;                /* PLACEHOLDER optional TMAG5273 INT */

		/* ---- status LEDs ---- */
		status-led-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;  /* PLACEHOLDER: on = active+docked, blinks = bench run */
		fault-led-gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;   /* PLACEHOLDER: on = latched fault */

		/* ---- SAADC: motor current sense (voltage across the STSPIN220 sense resistor(s)) ---- */
		io-channels = <&adc 0>;                          /* PLACEHOLDER AIN0 = P0.02 */
		io-channel-names = "imot";
	};
};
