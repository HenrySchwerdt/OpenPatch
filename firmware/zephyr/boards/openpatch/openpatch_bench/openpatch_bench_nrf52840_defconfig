# OpenPatch bench controller. Logs and the bench shell go over SEGGER RTT (SWD header), see
# zephyr/boards/openpatch_bench_nrf52840.conf for the shell and bench-mode options.
CONFIG_ARM_MPU=y
CONFIG_GPIO=y

# The bench module may or may not carry the 32.768 kHz crystal: use the calibrated internal RC
# (500 ppm, fine for a USB-powered bench unit). Switch to XTAL once the module is chosen.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

CONFIG_SERIAL=n
CONFIG_UART_CONSOLE=n
CONFIG_USE_SEGGER_RTT=y
