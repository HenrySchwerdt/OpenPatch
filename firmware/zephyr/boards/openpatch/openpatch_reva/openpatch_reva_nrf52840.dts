/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * OpenPatch Rev A: Insight SiP ISP1807 (nRF52840), insulin patch pump pod.
 * EXPERIMENTAL DIY DEVICE - NOT A MEDICAL DEVICE.
 *
 * All pin numbers come from electronics/pin-assignment.md (pad -> port.pin).
 * The application only uses the properties of the /zephyr,user node below, so
 * a bench setup (nrf52840dk) re-maps them in its own overlay and no C code
 * contains a pin number.
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <nordic/nrf52840_partition.dtsi>
#include "openpatch_reva_nrf52840-pinctrl.dtsi"

/ {
	model = "OpenPatch Rev A (ISP1807)";
	compatible = "openpatch,reva";

	chosen {
		zephyr,console = &rtt0;
		zephyr,shell-uart = &rtt0;
	};

	rtt0: rtt_chan0 {
		compatible = "segger,rtt-uart";
		status = "okay";
	};

	aliases {
		qdec-hall = &qdec0;
		watchdog0 = &wdt0;
	};

	zephyr,user {
		/* ---- STSPIN220 motor driver (full-step in firmware, see Kconfig) ---- */
		motor-stck-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;  /* MOT_STCK / MODE3 */
		motor-dir-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;   /* MOT_DIR / MODE4 */
		motor-mode1-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>; /* MOT_MODE1 */
		motor-mode2-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>; /* MOT_MODE2 */
		/* STBY/RESET: high = driver active; 100k pulldown on the board -> fail-safe */
		motor-stby-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		/* EN/FAULT is open drain with an internal pull-up at the driver: read only */
		motor-fault-gpios = <&gpio1 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

		/* ---- hardware safety latch (see electronics/README.md section 3) ---- */
		latch-arm-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;                /* ARM_CLK: rising edge arms */
		latch-kill-gpios = <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>; /* KILL_N: asserted = low */
		latch-mon-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;                /* LATCH_Q_MON: Q = MOT_ALLOW */

		/* ---- TPL5010 external watchdog ---- */
		wdt-done-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;  /* DONE: CPU-served only */
		wdt-wake-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>; /* WAKE pulse -> interrupt */

		/* ---- misc inputs / enables ---- */
		button-gpios = <&gpio0 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; /* BTN_N */
		/* DOCK_N: dock Hall switch DRV5032FA, active low = cannula-adapter magnet present = docked
		 * (P0.03, electronics/pin-assignment.md; also gates the motor supply in hardware) */
		dock-gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		qi-chg-gpios = <&gpio0 17 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; /* BQ51013B CHG, open drain */
		/* CHG_STAT: MCP73832 STAT, open drain, low = charging (no I2C charger on Rev A) */
		chg-stat-gpios = <&gpio0 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		tmag-int-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;

		/* ---- SAADC: VBAT only (1.5M/1M divider, V_adc = V * 0.4); VMOT sense is not populated ---- */
		io-channels = <&adc 3>;
		io-channel-names = "vbat";
	};
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>; /* ISP1807 has the DC/DC passives inside */
};

&uicr {
	gpio-as-nreset; /* P0.18 = nRESET, driven by the TPL5010 RSTn */
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* VBAT_SENSE on P0.05 / AIN3: 4.2 V * 0.4 = 1.68 V; gain 1/4 on the 0.6 V ref = 2.4 V full scale */
	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN3>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <3>;
	};
};

&i2c0 {
	compatible = "nordic,nrf-twim";
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	/* TMAG5273A1 3D hall: absolute spindle angle (path A of the delivery verification).
	 * The only I2C device on Rev A: the charger is an MCP73832 (no I2C, status pin only). */
	tmag5273: tmag5273@35 {
		compatible = "openpatch,i2c-chip";
		reg = <0x35>;
	};
};

/* Path B: the QDEC peripheral counts HALL_A/HALL_B without the CPU (4 counts per spindle revolution). */
&qdec0 {
	status = "okay";
	pinctrl-0 = <&qdec_default>;
	pinctrl-1 = <&qdec_sleep>;
	pinctrl-names = "default", "sleep";
	steps = <4>;
	led-pre = <0>;
	nordic,period = "SAMPLEPER_2048US";
};

/* RTC2 = step pulse timebase (RTC0/RTC1 belong to the BLE controller / kernel). */
&rtc2 {
	status = "okay";
};
