{
  "name": "openpatch-site",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "OpenPatch project site: an engineering notebook generated from the repository documents (test project, not a medical device)",
  "scripts": {
    "generate": "node scripts/prepare-models.mjs && node scripts/build-site.mjs",
    "prepare-models": "node scripts/prepare-models.mjs",
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "renders": "bash scripts/render-product.sh",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "marked": "18.2.1",
    "playwright-core": "1.65.1",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
