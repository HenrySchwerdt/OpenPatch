{
  "name": "openpatch-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Projektwebsite für OpenPatch – offene, abnehmbare Patch-Insulinpumpe (experimentell)",
  "scripts": {
    "prepare-models": "node scripts/prepare-models.mjs",
    "predev": "node scripts/prepare-models.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-models.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "marked": "18.2.1",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
