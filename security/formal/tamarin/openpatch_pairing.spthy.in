/*
 * OpenPatch protocol v1.1 -- PAIRING handshake (docs/04-protocol.md section 4.1, 5.1)
 * Implementation reference: firmware-rs/openpatch-proto/src/handshake.rs (Responder / Initiator, Mode::Pair).
 *
 * TEST PROJECT, not a medical device (see DISCLAIMER.md).
 *
 * Variants (select with -D on the command line, see security/formal/run.sh):
 *   (none)  TOFU   : no out-of-band code. This is the CURRENT bench default.
 *   -DOOB          : a high-entropy out-of-band secret printed on the pod / in a QR code is mixed into the HKDF salt
 *                    (docs/04-protocol.md section 4.3, proposal security/proposals/02-authenticated-pairing.md).
 *
 * Abstractions (all deliberate, all listed in security/formal/README.md):
 *   - X25519 is modelled as an abstract Diffie-Hellman group; low-order points are NOT modelled
 *     (the implementation rejects an all-zero shared secret, covered by unit tests, not by this model).
 *   - HKDF-Extract/Expand, SHA-256 and HMAC are modelled as independent random oracles / one-way functions
 *     with domain-separation labels as in the specification.
 *   - The out-of-band secret is modelled as UNGUESSABLE (Dolev-Yao). A short, human-typed code is guessable:
 *     that is NOT covered here but by security/formal/proverif/oob_guessing.pv (weak secret) and
 *     security/poc/oob_offline_guess.py (FINDING-002).
 *   - The pod's single pending slot is over-approximated by an unbounded number of pending handshakes
 *     (the attacker is given more power than in the implementation).
 *   - The button window is a linear fact: one button press authorises exactly one successful pairing.
 */
theory OpenPatch_Pairing
begin

builtins: diffie-hellman, hashing
functions: hmac/2

restriction Equality: "All x y #i. Eq(x, y) @ #i ==> x = y"

/* ---- out-of-band secret provisioning (variant OOB only) --------------------------------------------- */
#ifdef OOB
rule Oob_Provision:   // printed on the pod / QR code; handed to the user over a channel the radio attacker cannot see
  [ Fr(~oob) ] --[ OobProvisioned($B, ~oob) ]-> [ !OobPod($B, ~oob), !OobApp($B, ~oob) ]

rule Oob_Reveal:      // adversary compromise: the code leaks (shoulder surfing, photographed label)
  [ !OobPod($B, oob) ] --[ OobRevealed($B) ]-> [ Out(oob) ]
#endif

/* ---- pod (responder) ---------------------------------------------------------------------------------- */
rule Button_Press:    // physical authorisation: opens the pairing window once
  [ ] --[ Button($B) ]-> [ Window($B) ]

rule Pod_PairInit:
  let pubB = 'g'^~xb
      dh   = pubA^~xb
#ifdef OOB
      salt = h(<'oob', oob>)
#else
      salt = '0'
#endif
      th   = h(<'th', 'pair', pubA, pubB, nA, ~nB>)
      ps   = h(<'ps', dh, salt, th>)
      ck   = h(<'ck', dh, salt, th>)
      conf = hmac(ck, <'pod', th>)
  in
  [ In(<pubA, nA>), Window($B), Fr(~xb), Fr(~nB)
#ifdef OOB
  , !OobPod($B, oob)
#endif
  ]
  --[ PodPairInit($B, th) ]->
  [ Window($B), Out(<pubB, ~nB, conf>), PodPend($B, ps, ck, th) ]

rule Pod_PairFinish:
  [ In(cApp), PodPend($B, ps, ck, th), Window($B) ]
  --[ Eq(cApp, hmac(ck, <'app', th>)), PodPaired($B, ps, th) ]->
  [ !PodPS($B, ps), Out('ok') ]

/* ---- phone (initiator) -------------------------------------------------------------------------------- */
rule App_PairStart:
  [ Fr(~xa), Fr(~nA)
#ifdef OOB
  , !OobApp($B, oob)
#endif
  ]
  --[ AppPairStart($A, $B) ]->
  [ Out(<'g'^~xa, ~nA>), AppInit($A, $B, ~xa, ~nA)
#ifdef OOB
  , AppOob($A, $B, oob)
#endif
  ]

rule App_PairFinish:
  let pubA = 'g'^~xa
      dh   = pubB^~xa
#ifdef OOB
      salt = h(<'oob', oob>)
#else
      salt = '0'
#endif
      th   = h(<'th', 'pair', pubA, pubB, ~nA, nB>)
      ps   = h(<'ps', dh, salt, th>)
      ck   = h(<'ck', dh, salt, th>)
  in
  [ AppInit($A, $B, ~xa, ~nA), In(<pubB, nB, conf>)
#ifdef OOB
  , AppOob($A, $B, oob)
#endif
  ]
  --[ Eq(conf, hmac(ck, <'pod', th>)), AppPaired($A, $B, ps, th) ]->
  [ Out(hmac(ck, <'app', th>)), !AppPS($A, $B, ps) ]

/* ---- sanity ------------------------------------------------------------------------------------------ */
lemma executable_pairing:   // an honest run exists (guards against vacuous proofs)
  exists-trace
  "Ex A B ps th #i #j. AppPaired(A, B, ps, th) @ #i & PodPaired(B, ps, th) @ #j"

/* ---- security properties ---------------------------------------------------------------------------- */

// P1 secrecy of the pairing secret PS (the long-term root of every later session key).
lemma pairing_secret_ps:
#ifdef OOB
  "All A B ps th #i. AppPaired(A, B, ps, th) @ #i ==> (not (Ex #k. K(ps) @ #k)) | (Ex #r. OobRevealed(B) @ #r)"
#else
  "All A B ps th #i. AppPaired(A, B, ps, th) @ #i ==> (not (Ex #k. K(ps) @ #k))"
#endif

// P2 the phone's view agrees with the pod's: the pod ran the SAME transcript (same keys, same nonces).
lemma pairing_agreement_app:
#ifdef OOB
  "All A B ps th #i. AppPaired(A, B, ps, th) @ #i ==>
        (Ex #j. PodPairInit(B, th) @ #j & #j < #i) | (Ex #r. OobRevealed(B) @ #r)"
#else
  "All A B ps th #i. AppPaired(A, B, ps, th) @ #i ==> (Ex #j. PodPairInit(B, th) @ #j & #j < #i)"
#endif

// P3 injective agreement from the pod's side: a stored PS was produced by exactly one honest phone run.
lemma pairing_agreement_pod_injective:
#ifdef OOB
  "All B ps th #i. PodPaired(B, ps, th) @ #i ==>
        ((Ex A #j. AppPaired(A, B, ps, th) @ #j & #j < #i)
          & not (Ex #i2. PodPaired(B, ps, th) @ #i2 & not (#i2 = #i)))
        | (Ex #r. OobRevealed(B) @ #r)"
#else
  "All B ps th #i. PodPaired(B, ps, th) @ #i ==>
        ((Ex A #j. AppPaired(A, B, ps, th) @ #j & #j < #i)
          & not (Ex #i2. PodPaired(B, ps, th) @ #i2 & not (#i2 = #i)))"
#endif

end
