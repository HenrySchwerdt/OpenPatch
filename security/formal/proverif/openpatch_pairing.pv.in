(* ProVerif cross-check of the OpenPatch v1.1 pairing handshake (docs/04-protocol.md 4.1, 5.1) and, for the
 * guessing question, of the low-entropy out-of-band code. TEST PROJECT, not a medical device.
 *
 * Variants (security/formal/run.sh generates one file per variant with preprocess.py):
 *   -DTOFU    no out-of-band code (current bench default)
 *   -DOOB     64+ bit random out-of-band secret in the HKDF salt (what proposal 02 needs at minimum)
 *   -DWEAK    out-of-band secret is LOW ENTROPY (6 digit code): query = weaksecret, current key schedule
 *   -DCPACE   as -DWEAK, but the code only derives the DH generator (PAKE shape, as in CPace / SPAKE2+)
 *
 * Abstractions as in security/formal/tamarin/openpatch_pairing.spthy.in (ideal hashes, abstract DH group,
 * no low-order points).
 *)

free c: channel.

type G.
type exponent.
const g: G.
fun exp(G, exponent): G.
fun gen(bitstring): G.            (* hash-to-group, only used by -DCPACE *)
#ifdef CPACE
equation forall w: bitstring, x: exponent, y: exponent; exp(exp(gen(w), x), y) = exp(exp(gen(w), y), x).
#else
equation forall x: exponent, y: exponent; exp(exp(g, x), y) = exp(exp(g, y), x).
#endif

fun h(bitstring): bitstring.
fun hmac(bitstring, bitstring): bitstring.

fun toBits(G): bitstring [data, typeConverter].

const L0: bitstring. const L1: bitstring. const L2: bitstring. const L3: bitstring. const L4: bitstring.
free oob: bitstring [private].

#ifdef WEAK
weaksecret oob.
#endif
#ifdef CPACE
weaksecret oob.
#endif

event PodInit(bitstring).
event PodPaired(bitstring, bitstring).
event AppPaired(bitstring, bitstring).

#ifdef OOB
query attacker(oob).
#endif

query ps: bitstring, th: bitstring; event(AppPaired(ps, th)) && attacker(ps).   (* secrecy of every PS an honest phone stores *)
query ps: bitstring, th: bitstring; inj-event(PodPaired(ps, th)) ==> inj-event(AppPaired(ps, th)).
query ps: bitstring, th: bitstring; inj-event(AppPaired(ps, th)) ==> event(PodInit(th)).

(* salt / generator selection *)
#ifdef TOFU
letfun salt() = h((L0)).
letfun base() = g.
#endif
#ifdef OOB
letfun salt() = h((L0, oob)).
letfun base() = g.
#endif
#ifdef WEAK
letfun salt() = h((L0, oob)).
letfun base() = g.
#endif
#ifdef CPACE
letfun salt() = h((L0)).
letfun base() = gen(oob).
#endif

let Pod() =
  in(c, (pubA: G, nA: bitstring));
  new b: exponent; new nB: bitstring;
  let pubB = exp(base(), b) in
  let dh = exp(pubA, b) in
  let th = h((toBits(pubA), toBits(pubB), nA, nB)) in
  let ps = h((L1, toBits(dh), salt(), th)) in
  let ck = h((L2, toBits(dh), salt(), th)) in
  event PodInit(th);
  out(c, (pubB, nB, hmac(ck, (L3, th))));
  in(c, cApp: bitstring);
  if cApp = hmac(ck, (L4, th)) then
  event PodPaired(ps, th).

let App() =
  new a: exponent; new nA: bitstring;
  let pubA = exp(base(), a) in
  out(c, (pubA, nA));
  in(c, (pubB: G, nB: bitstring, conf: bitstring));
  let dh = exp(pubB, a) in
  let th = h((toBits(pubA), toBits(pubB), nA, nB)) in
  let ps = h((L1, toBits(dh), salt(), th)) in
  let ck = h((L2, toBits(dh), salt(), th)) in
  if conf = hmac(ck, (L3, th)) then
  event AppPaired(ps, th);
  out(c, hmac(ck, (L4, th))).

process
  (!Pod()) | (!App())
