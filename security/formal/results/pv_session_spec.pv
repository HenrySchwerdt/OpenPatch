(* GENERATED by security/formal/preprocess.py from openpatch_session.pv.in with defines none -- do not edit *)
(* ProVerif model of the OpenPatch v1.1 SESSION handshake and protected command channel
 * (docs/04-protocol.md 4.2, 4.3, 5.2, 6). TEST PROJECT, not a medical device.
 * Implementation: firmware-rs/openpatch-proto/src/{handshake.rs,session.rs}.
 *
 * Starting point: phone and pod share one pairing secret `ps` (output of an AUTHENTICATED pairing; see
 * openpatch_pairing.pv.in -DOOB). Sessions run in phase 0; in phase 1 the long-term secret leaks (forward secrecy).
 *
 * Variants: (none) specified protocol; -DREFLECT adds the behaviour of the current Session::open (FINDING-001):
 * a pod->phone RESPONSE frame is accepted by the pod, skips the replay table and refreshes the heartbeat.
 * Abstractions: ideal hashes/HMAC/AEAD, abstract DH group without low-order points, seq filter = table.
 *)

free c: channel.

type G.
type exponent.
const g: G.
fun exp(G, exponent): G.
equation forall x: exponent, y: exponent; exp(exp(g, x), y) = exp(exp(g, y), x).
fun toBits(G): bitstring [data, typeConverter].

fun h(bitstring): bitstring.
fun hmac(bitstring, bitstring): bitstring.
fun senc(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring; sdec(senc(m, k), k) = m.

const Lpsid: bitstring. const Lth: bitstring. const Lprk: bitstring. const Lc2p: bitstring. const Lp2c: bitstring.
const Lck: bitstring. const Lpod: bitstring. const Lapp: bitstring. const Lcmd: bitstring. const Lrsp: bitstring.

free ps: bitstring [private].          (* the pairing secret of the one honest phone/pod pair *)


event PodInit(bitstring, bitstring, bitstring).
event ReflectedAccepted(bitstring, bitstring).
event PodUp(bitstring, bitstring, bitstring).
event AppUp(bitstring, bitstring, bitstring).
event AppSecret(bitstring).
event PodSecret(bitstring).
event CmdSent(bitstring, bitstring).
event CmdExec(bitstring, bitstring).
event Heartbeat(bitstring, bitstring).
event RspSent(bitstring, bitstring).
event RspAccepted(bitstring, bitstring).

(* S1 / S2 secrecy of data protected by the session keys; with the phase-1 leak of ps this is forward secrecy. *)
query m: bitstring; event(AppSecret(m)) && attacker(m).
query m: bitstring; event(PodSecret(m)) && attacker(m).
(* S4 injective agreement, pod side: every installed session matches exactly one phone run (keys + transcript). *)
query th: bitstring, kc: bitstring, kp: bitstring; inj-event(PodUp(th, kc, kp)) ==> inj-event(AppUp(th, kc, kp)).
(* S5 injective agreement, phone side: the phone only accepts a pod that derived the same keys in this run. *)
query th: bitstring, kc: bitstring, kp: bitstring; inj-event(AppUp(th, kc, kp)) ==> inj-event(PodInit(th, kc, kp)).
(* S6 / S7 command and response authenticity. NOT injective here: ProVerif cannot express the pod's monotonic
   seq filter (a `table` else-branch is over-approximated); replay rejection is discharged by
   security/verify/tests/proto_props.rs (replay_and_ordering) and the Tamarin restriction SeqOnce. *)
query th: bitstring, sq: bitstring; event(CmdExec(th, sq)) ==> event(CmdSent(th, sq)).
query th: bitstring, sq: bitstring; event(RspAccepted(th, sq)) ==> event(RspSent(th, sq)).
(* S8 FINDING-001: can the attacker make the pod accept a pod->phone frame as if it were phone input?
   Expected: NOT reachable for the specified protocol, REACHABLE with -DREFLECT (current Session::open). *)
query th: bitstring, sq: bitstring; event(ReflectedAccepted(th, sq)).

let Pod() =
  in(c, (pubA: G, nA: bitstring, psid: bitstring));
  if psid = h((Lpsid, ps)) then
  new xb: exponent; new nB: bitstring;
  let pubB = exp(g, xb) in
  let dh = exp(pubA, xb) in
  let th = h((Lth, psid, toBits(pubA), toBits(pubB), nA, nB)) in
  let prk = h((Lprk, ps, toBits(dh))) in
  let kc = h((Lc2p, prk, th)) in
  let kp = h((Lp2c, prk, th)) in
  let ck = h((Lck, prk, th)) in
  event PodInit(th, kc, kp);
  out(c, (pubB, nB, hmac(ck, (Lpod, th))));
  in(c, cApp: bitstring);
  if cApp = hmac(ck, (Lapp, th)) then
  event PodUp(th, kc, kp);
  new m: bitstring; event PodSecret(m); out(c, senc(m, kp));
  (
    (* commands, key_c2p *)
    !(in(c, w: bitstring);
      let (=Lcmd, sq: bitstring, cmd: bitstring) = sdec(w, kc) in
      event CmdExec(th, sq);
      event RspSent(th, sq);
      out(c, senc((Lrsp, sq, h(cmd)), kp)))
  ).

let App() =
  new xa: exponent; new nA: bitstring;
  let pubA = exp(g, xa) in
  let psid = h((Lpsid, ps)) in
  out(c, (pubA, nA, psid));
  in(c, (pubB: G, nB: bitstring, conf: bitstring));
  let dh = exp(pubB, xa) in
  let th = h((Lth, psid, toBits(pubA), toBits(pubB), nA, nB)) in
  let prk = h((Lprk, ps, toBits(dh))) in
  let kc = h((Lc2p, prk, th)) in
  let kp = h((Lp2c, prk, th)) in
  let ck = h((Lck, prk, th)) in
  if conf = hmac(ck, (Lpod, th)) then
  event AppUp(th, kc, kp);
  out(c, hmac(ck, (Lapp, th)));
  new m: bitstring; event AppSecret(m); out(c, senc(m, kc));
  (
    (new sq: bitstring; new cmd: bitstring; event CmdSent(th, sq); out(c, senc((Lcmd, sq, cmd), kc)))
    |
    (in(c, w: bitstring); let (=Lrsp, sq: bitstring, r: bitstring) = sdec(w, kp) in event RspAccepted(th, sq))
  ).

(* variants of the compromise model:
 *   (none)   PS leaks in phase 1, i.e. AFTER every session (forward secrecy w.r.t. PS)
 *   -DLEAK0  PS is known to the attacker from the start (sanity check: every property must then FAIL, so the
 *            proofs above are not vacuous)  *)
process (!Pod()) | (!App()) | (phase 1; out(c, ps))
